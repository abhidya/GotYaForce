{
  "name": "gotcha-force-web",
  "version": "0.0.0",
  "private": true,
  "description": "Browser recreation of the GameCube game Gotcha Force (region GG4E / NTSC-U).",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter game dev",
    "typecheck": "tsc -b tsconfig.json apps/game/tsconfig.json",
    "selfcheck:1p": "node scripts/selfcheck-1p-challenge.mjs",
    "selfcheck:challenge-stages": "node scripts/selfcheck-challenge-stages.mjs",
    "selfcheck:force-builder": "node scripts/selfcheck-force-builder.mjs",
    "selfcheck:menu-flow": "node scripts/selfcheck-menu-flow.mjs && node --test scripts/menu-key-repeat.test.mjs scripts/controller-pause-race.test.mjs scripts/bgm-transition-race.test.mjs scripts/animation-cache-recovery.test.mjs && node scripts/run-battle-scene-morph-selfcheck.mjs",
    "selfcheck:title-frontend": "node scripts/selfcheck-title-frontend.mjs",
    "selfcheck:game-session": "node scripts/selfcheck-game-session.mjs && node --test scripts/affordable-force-prefix.test.mjs",
    "selfcheck:battle-input-focus": "node --test scripts/battle-input-focus.test.mjs scripts/touch-input-focus.test.mjs",
    "selfcheck:battle-pause-edge": "node --test scripts/battle-pause-input-edge.test.mjs scripts/battle-pause-presentation.test.mjs scripts/authored-swing-audio-lifetime.test.mjs",
    "selfcheck:browser-cdp": "node --test scripts/cdp-client.test.mjs scripts/network-gate.test.mjs",
    "selfcheck:browser-poc-gate": "node --test scripts/finish-game-port-browser-gate.test.mjs",
    "test:render-loop": "node scripts/run-render-loop-tests.mjs",
    "smoke:browser": "node scripts/smoke-browser-game.mjs",
    "smoke:rom-runtime": "node scripts/smoke-rom-runtime-phase.mjs",
    "selfcheck:get-settlement": "pnpm --filter @gf/missions build && node packages/missions/dist/gotchaBoxSettlement.selfcheck.js && node scripts/selfcheck-get-storage.mjs",
    "selfcheck:hud": "node scripts/selfcheck-hud.mjs",
    "selfcheck:xammo": "node scripts/run-xammo-tests.mjs",
    "selfcheck:challenge-flow": "node scripts/run-challenge-flow-tests.mjs",
    "selfcheck:arrow-projectiles": "node scripts/run-battle-scene-arrow-selfcheck.mjs",
    "selfcheck:beam-projectiles": "node scripts/run-battle-scene-beam-selfcheck.mjs",
    "selfcheck:revolver-launch-flashes": "node scripts/run-battle-scene-revolver-flash-selfcheck.mjs",
    "selfcheck:gatling-projectiles": "node scripts/run-battle-scene-gatling-selfcheck.mjs",
    "selfcheck:gblack-charge": "node scripts/run-battle-scene-gblack-charge-selfcheck.mjs",
    "selfcheck:teleport": "node scripts/run-battle-scene-teleport-selfcheck.mjs",
    "selfcheck:ninja-projectiles": "node scripts/run-battle-scene-ninja-selfcheck.mjs",
    "selfcheck:gred-ranged": "node scripts/run-battle-scene-gred-ranged-selfcheck.mjs",
    "selfcheck:source-animation": "node scripts/run-battle-scene-source-animation-selfcheck.mjs",
    "selfcheck:gblack-wave": "node scripts/run-battle-scene-gblack-wave-selfcheck.mjs",
    "selfcheck:time-bomber-projectiles": "node scripts/run-battle-scene-time-bomber-selfcheck.mjs",
    "selfcheck:powered-launch-flashes": "node scripts/run-battle-scene-powered-flash-selfcheck.mjs",
    "test:render-disposal": "node --test packages/render/src/disposeObject3D.test.mjs",
    "selfcheck:camera": "node scripts/run-source-camera-tests.mjs",
    "selfcheck:rom": "node scripts/run-rom-tests.mjs",
    "selfcheck:battle-scene-morph": "tsc -p apps/game/tsconfig.json --noEmit && node scripts/run-battle-scene-morph-selfcheck.mjs",
    "selfcheck:readability-flagged-stages": "node scripts/selfcheck-readability-flagged-stages.mjs",
    "audit:move-wiring": "node scripts/audit-move-wiring.mjs",
    "audit:family-state-machines": "node scripts/audit-family-state-machines.mjs",
    "audit:move-unblockers": "node scripts/audit-move-unblockers.mjs",
    "audit:stage-readability": "node scripts/audit-stage-readability.mjs",
    "gen:command-move-tables": "node scripts/gen-command-move-tables.mjs",
    "clean": "pnpm -r exec rimraf dist tsconfig.tsbuildinfo",
    "extract": "node scripts/extract-user-disc.mjs",
    "sync:assets": "node scripts/sync-exported-assets.mjs",
    "convert:glb": "node scripts/convert-runtime-models-to-glb.mjs",
    "manifest:model-library": "node scripts/build-model-library-manifest.mjs",
    "export:borg-anim": "node scripts/export-borg-animation-hsd.mjs",
    "index:decomp": "node scripts/build-decomp-evidence-index.mjs",
    "import:oghidra-port": "node scripts/import-oghidra-port-artifact.mjs",
    "test:oghidra-port": "node --test scripts/test-oghidra-port-import.mjs",
    "verify:oghidra-port": "node scripts/verify-oghidra-eagle-jet-live.mjs",
    "port:finish:poc": "node scripts/finish-game-port-poc.mjs",
    "port:finish:poc:fresh": "node scripts/finish-game-port-poc.mjs --refresh-artifact",
    "port:finish:poc:resume": "node scripts/finish-game-port-poc.mjs --resume-qwen-checkpoint",
    "inventory:challenge-flow": "node scripts/inventory-challenge-flow-evidence.mjs",
    "inventory:archive-load": "node scripts/inventory-archive-load-xrefs.mjs",
    "inventory:challenge-memory": "python scripts/inventory-challenge-memory-evidence.py",
    "manifest:stages": "node scripts/build-stage-manifests.mjs && node scripts/build-stage-catalog-module.mjs",
    "manifest:stage-render-state": "node scripts/export-stage-render-state.mjs --all",
    "manifest:stage-catalog": "node scripts/build-stage-catalog-module.mjs",
    "manifest:ui-scenes": "node scripts/generate-ui-scene-layouts.mjs",
    "runtime:assets": "pnpm convert:glb && pnpm manifest:model-library && pnpm manifest:stages && pnpm manifest:stage-render-state && pnpm manifest:ui-scenes",
    "convert": "node scripts/asset-convert.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "atlas:curate": "node docs-site/scripts/curate-data.mjs",
    "atlas:dev": "pnpm atlas:curate && pnpm --filter gotcha-force-atlas dev",
    "atlas:build": "pnpm atlas:curate && pnpm --filter gotcha-force-atlas build",
    "atlas:preview": "pnpm --filter gotcha-force-atlas preview",
    "test:repo-policy": "node --test scripts/repository-policy.test.mjs",
    "test:oracle": "node research/decomp/oracle-harness/tests/run-oracle-tests.mjs",
    "verify:contributor": "pnpm test:repo-policy && pnpm typecheck && pnpm selfcheck:browser-poc-gate && pnpm selfcheck:hud && pnpm selfcheck:menu-flow && pnpm selfcheck:force-builder && pnpm selfcheck:game-session && pnpm selfcheck:battle-pause-edge && pnpm selfcheck:battle-input-focus && pnpm selfcheck:title-frontend && pnpm selfcheck:camera && pnpm selfcheck:challenge-flow && pnpm test:render-disposal && pnpm selfcheck:powered-launch-flashes && pnpm selfcheck:gatling-projectiles && pnpm selfcheck:time-bomber-projectiles && pnpm selfcheck:gblack-wave && pnpm selfcheck:gblack-charge && pnpm selfcheck:gred-ranged && pnpm selfcheck:ninja-projectiles && pnpm selfcheck:teleport && pnpm selfcheck:source-animation && pnpm selfcheck:revolver-launch-flashes && pnpm selfcheck:beam-projectiles && pnpm selfcheck:arrow-projectiles && pnpm selfcheck:rom && pnpm --filter @gf/combat test:lifecycle && pnpm test:oghidra-port && pnpm --filter game build",
    "verify:docs": "pnpm atlas:build"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@xmldom/xmldom": "^0.9.10",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "^0.169.0",
    "typescript": "^5.6.0"
  }
}
