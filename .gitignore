# --- Dependencies & build output ---
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
coverage/
*.log
__pycache__/
*.pyc

# --- Editor / OS noise ---
.DS_Store
Thumbs.db
.idea/
.claude/
.vscode/*
!.vscode/extensions.json

# --- User-local binary data ---
# IMPORTANT: The disc ISO and any extracted disc bytes are USER-SUPPLIED and stay
# strictly local. They are NEVER committed — both for repo hygiene/size and to keep
# the repository free of game-data dumps. Only synthetic samples are tracked.
*.iso
*.gcm
*.rvz
*.ciso
*.wbfs
dotnet-sdk-*.exe
user-data/

# Per-region disc extracts: hashes/FST/magic maps are user-generated, kept local.
research/disc/*/
# ...but preserve the folder itself in the tree.
!research/disc/.gitkeep

# --- Externally cloned tooling (NOT vendored into this repo) ---
# /tools/ is populated by another agent cloning NeoGF etc.; dolphin/ is a local install.
#
# ANCHORED DELIBERATELY. This rule was written unanchored as `tools/`, and an
# unanchored directory pattern matches at EVERY level -- so it was also hiding
# `research/tools/`, where this repo's own harnesses live. Existing files there
# stayed visible only because they were already tracked; every NEW file added
# under research/tools/ was silently ignored. Found 2026-09-03 when
# research/tools/matching-decomp/TOOLCHAIN.md would not stage.
/tools/
dolphin/
.tools/
GameCubeLoader/
ghidra_*_PUBLIC/
ghidra_*_PUBLIC_*.zip

# Local Ghidra project state. The exported decompile corpus under
# research/decomp/ghidra-export/ is the tracked artifact, not the GUI database.
research/decomp/*.gpr
research/decomp/*.lock
research/decomp/*.lock~
research/decomp/*.rep/

# Derived per-function reorganization of the ghidra-export corpus.
# Regenerate any time with: node scripts/reorg-decomp.mjs
research/decomp/organized/

# Live Dolphin capture scratch output.
hp_log.csv

# Local-model transcripts and autonomous port runtime/checkpoint state.
# The browser source changes are durable; these files are regenerated per run.
logs/llm_interactions_*.json
research/decomp/generated/finish-game-port/
# T2c knowledge registry (design 2.11 [V4-8]): the ONE tracked file inside the
# wholesale-ignored generated dir -- it is the cross-unit assembly ledger and
# must be versioned by git. A gitignored parent dir would silently untrack it,
# so the negation needs BOTH lines (git cannot re-include inside an excluded
# directory unless the directory itself is re-included).
!research/decomp/generated/finish-game-port/
research/decomp/generated/finish-game-port/*
!research/decomp/generated/finish-game-port/knowledge-registry.json

# Dolphin savestates stay local: they embed the emulated RAM image (boot.dol code +
# loaded disc assets), i.e. ROM-derived bytes — see the never-commit rule.
*.sav
# Memory-card saves (.gci) are pure progress data (no game code) and ARE tracked —
# they're the standard starting saves for research/decomp/attack-mechanics-trace-plan.md.

# Local extraction/build scratch. .tmp/ is also a build OUTPUT dir -- the
# battle-scene-morph selfcheck bundles into .tmp/, and agent/pytest scratch
# trees are created here. Nothing in it is durable.
.tmp/
.pnpm-store/
.pytest_cache/
/scratchpad/
/.agents/
# Local run logs. `*.log` already covers the vite/dev transcripts; this covers the
# whole directory so JSON model transcripts dropped here cannot be committed either.
/logs/

# Agent worktrees. Claude Code checks agent worktrees out under .claude/worktrees/
# (covered by the .claude/ rule above) and older tooling used .tmp/*-worktree.
# These are ~1.2 GB apiece once node_modules is installed and are never durable:
# a finished agent's work reaches main through its branch, not its worktree.
/.tmp/*-worktree/
/.claude/worktrees/

# Private review/audit drafts. Durable conclusions belong in contributor or
# design documentation, not in machine-generated review transcripts. The whole
# directory is ignored so ad-hoc session notes cannot silently accumulate;
# files already tracked under .superpowers/sdd/ stay tracked regardless.
/.superpowers/**

# Oracle harness scratch: dolphin traces are regenerated per port run and land
# here by the hundreds. The few that are real, curated evidence were added
# deliberately and stay tracked; promote a new one with `git add -f`.
research/decomp/oracle-harness/corpora/*.dolphin-trace.jsonl

# Installers are fetched from their publisher, never vendored at repo root.
/python-manager-*.msix

# Secrets / local env — never commit.
.env
.env.local

# Unsloth (LLM fine-tuning) compiled cache — local ML artifact, not source.
unsloth_compiled_cache/

# Matching-decompilation scratch: candidates mid-iteration and the negative
# controls verify.py writes. Results live in src-match/{game,sdk,blocked}/.
src-match/work/
